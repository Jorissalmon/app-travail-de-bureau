{
  "name": "releve",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "ota:local": "node --experimental-strip-types scripts/ota-package.ts",
    "cap:sync": "vite build && cap sync android",
    "apk": "vite build && cap sync android && node --experimental-strip-types scripts/gradle.ts assembleRelease",
    "gen:seed": "node --experimental-strip-types scripts/gen-seed.ts",
    "pretest": "node --experimental-strip-types scripts/gen-seed.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.0.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capawesome-team/capacitor-android-battery-optimization": "^8.0.1",
    "@capgo/capacitor-updater": "^8.51.15",
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "^3.0.2",
    "capacitor-native-settings": "^8.2.0",
    "dompurify": "^3.2.7",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "marked": "^16.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.37.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.9",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^5.3.29",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "jszip": "^3.10.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
